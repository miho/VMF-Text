package ${packageName};

// TODO 19.08.2018 get rid of this import to prevent name clashes
import eu.mihosoft.vmf.core.*;

@VMFModel(
  equality=VMFEquals.EqualsType.CONTAINMENT_AND_EXTERNAL
)
interface ${Util.firstToUpper($model.grammarName)}Model {
#if(${model.hasRootClass()})

  ${model.rootClass().nameWithUpper()} getRoot();

#end
}

@eu.mihosoft.vmf.core.Immutable
interface CodeRange {
  CodeLocation getStart();
  CodeLocation getStop();
  int getLength();
}

@eu.mihosoft.vmf.core.Immutable
interface CodeLocation {
  int getIndex();
  int getLine();
  int getCharPosInLine();
}

interface LexicalInfo {
  @eu.mihosoft.vmf.core.IgnoreEquals
  @eu.mihosoft.vmf.core.Contains
  TriviaPiece[] getTriviaPieces();

  /**
   * @deprecated Prefer {@link #getOptionalStates()} (path-keyed,
   *             occurrence-indexed). Kept as a derived legacy view for
   *             pre-0.2.1 consumers; removal targeted for a future minor.
   */
  @java.lang.Deprecated
  @eu.mihosoft.vmf.core.IgnoreEquals
  Boolean[] getOptionalSymbols();

  @eu.mihosoft.vmf.core.IgnoreEquals
  @eu.mihosoft.vmf.core.Contains
  OptionalState[] getOptionalStates();

  /**
   * Original lexer-rule spellings captured at parse time, keyed by property
   * name and list index ({@code -1} for singular properties). Used on unparse
   * when the semantic value is unchanged so {@code 1} stays {@code 1} instead
   * of {@code 1.0}.
   */
  @eu.mihosoft.vmf.core.IgnoreEquals
  @eu.mihosoft.vmf.core.Contains
  OriginalLexeme[] getOriginalLexemes();

  @eu.mihosoft.vmf.core.IgnoreEquals
  @eu.mihosoft.vmf.core.Contains
  ListShapeHint[] getListShapeHints();

  @eu.mihosoft.vmf.core.IgnoreEquals
  String getGrammarElementPath();

  @eu.mihosoft.vmf.core.IgnoreEquals
  CodeRange getOriginalRange();
}

interface TriviaPiece {
  String getText();
  String getKind();
}

interface OptionalState {
  String getGrammarElementPath();
  /**
   * Zero-based occurrence of this path on the owning rule instance.
   * Consumed exactly (not via a shifting counter) so mixed presence of the
   * same path cannot be reassigned to earlier encounters. {@code -1} means
   * legacy / unknown (formatter falls back to encounter order).
   */
  int getOccurrenceIndex();
  boolean getPresent();
}

/**
 * Codegen hint describing how a list property maps onto trivia slots, so
 * structural add/remove can splice without guessing from {@code trivia.size()}.
 *
 * <p>Slot math (primitive lists, where each item also owns a value slot):
 * {@code size = prefix + n + (n-1)*separatorCount + suffix}.
 * Model-typed lists omit per-item value slots on the parent:
 * {@code size = prefix + (n-1)*separatorCount + suffix} (empty → {@code prefix+suffix}).
 */
interface ListShapeHint {
  String getPropertyName();
  /** {@code PRIMITIVE_DELIMITED} or {@code MODEL_DELIMITED}. */
  String getKind();
  /** Terminals belonging to this list before the first item (e.g. {@code 1} for {@code '('}). */
  int getPrefixCount();
  /** Terminals belonging to this list after the last item (e.g. {@code ')'}, EOF pad). */
  int getSuffixCount();
  /**
   * Terminals between consecutive items ({@code 1} for {@code ','}, {@code 2} for
   * {@code ',' 'and'}, {@code 0} for {@code item+ } / no separator).
   */
  int getSeparatorCount();
  /** Declaration order among list properties on the same rule (0-based). */
  int getOrderIndex();
  boolean getModelTyped();
}

interface OriginalLexeme {
  String getPropertyName();
  int getIndex();
  String getText();
  /** {@code String.valueOf(semanticValue)} at parse / last successful bind. */
  String getValueKey();
}

@eu.mihosoft.vmf.core.InterfaceOnly
@eu.mihosoft.vmf.core.DelegateTo(className="${delegationPackageName}.CodeElementDelegate")
interface CodeElement {
  //@eu.mihosoft.vmf.core.IgnoreToString
  @eu.mihosoft.vmf.core.IgnoreEquals
  CodeRange getCodeRange();

  @eu.mihosoft.vmf.core.IgnoreEquals
  CodeElement getParent();

  @eu.mihosoft.vmf.core.DelegateTo(className="${delegationPackageName}.CodeElementDelegate")
  CodeElement root();

  @eu.mihosoft.vmf.core.DelegateTo(className="${delegationPackageName}.CodeElementDelegate")
  eu.mihosoft.vcollections.VList<CodeElement> pathToRoot();

  /**
   * @deprecated VMF-Text no longer stores lexical metadata in the payload map.
   *             Use {@link #getLexicalInfo()} for source-preserving metadata.
   */
  @java.lang.Deprecated
  @eu.mihosoft.vmf.core.IgnoreEquals
  Object getPayload();

  @eu.mihosoft.vmf.core.IgnoreEquals
  @eu.mihosoft.vmf.core.Contains
  LexicalInfo getLexicalInfo();

  @eu.mihosoft.vmf.core.DelegateTo(className="${delegationPackageName}.CodeElementDelegate")
  String asString();
}

#foreach( $rcls in ${model.ruleClasses} )
#if( !$rcls.childClasses.empty )
@eu.mihosoft.vmf.core.InterfaceOnly
#end
#foreach( $ann in ${rcls.getCustomRuleAnnotations()} )
$ann.getText()
#end
interface ${rcls.nameWithUpper()}#if($rcls.superClass) extends ${rcls.superClass.nameWithUpper()}#else extends CodeElement#end#if(!$rcls.getSuperInterfaces().isEmpty()), /*custom model types:*/ #end${rcls.superInterfacesString()} {
#set($ruleClass=$rcls)
#parse("${TEMPLATE_PATH}rule-class.vm")

  // Delegation methods
#foreach( $dm in ${rcls.delegationMethods} )
  $dm.getText()
#end

}

#end## end for each rule class

// Custom model classes

#foreach( $cmc in ${model.customRules})
$cmc.getText()
#end
