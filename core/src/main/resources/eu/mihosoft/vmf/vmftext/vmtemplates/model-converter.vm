public final class ${Util.firstToUpper($model.grammarName)}ModelParser {

    public ${Util.firstToUpper($model.grammarName)}ModelParser() {
        //
    }

    /**
     * Maps each converted {@link CodeElement} to its ANTLR rule context during
     * conversion. Cleared after lexical metadata has been attached.
     */
    private final java.util.IdentityHashMap<CodeElement, ParserRuleContext> conversionRuleContexts =
            new java.util.IdentityHashMap<>();

    private final List<ANTLRErrorListener> errorListeners = new ArrayList<>();
    private ANTLRErrorStrategy errorHandler;
    private boolean consoleOutputDisabled;

    public void setConsoleOutputDisabled(boolean state) {
        this.consoleOutputDisabled = state;
    }

    public boolean isConsoleOutputDisabled() {
        return this.consoleOutputDisabled;
    }

    public List<ANTLRErrorListener> getErrorListeners() {
        return this.errorListeners;
    }

    public void setErrorHandler(ANTLRErrorStrategy errorHandler) {
        this.errorHandler = errorHandler;
    }

    /**
     * Creates a source bundle that stores a semantic model together with the
     * source text it was parsed from. The bundle can later be restored via
     * {@link #restoreFromSourceBundle(${Util.firstToUpper($model.grammarName)}SourceBundle)}.
     */
    public ${Util.firstToUpper($model.grammarName)}SourceBundle toSourceBundle(${Util.firstToUpper($model.grammarName)}Model model, String sourceText) {
        return ${Util.firstToUpper($model.grammarName)}SourceBundle.fromModelAndSource(model, sourceText);
    }

    /**
     * Restores a model from a source bundle. If the bundled source reparses
     * successfully and the reparsed semantic model equals the stored model, the
     * reparsed model is returned so that fresh lexical preservation payload is
     * available. Otherwise the stored semantic model is returned after VMF-Text
     * lexical payload has been cleared to avoid using stale formatting metadata.
     */
    public ${Util.firstToUpper($model.grammarName)}Model restoreFromSourceBundle(${Util.firstToUpper($model.grammarName)}SourceBundle bundle) {
        return restoreFromSourceBundle(bundle, true);
    }

    /**
     * Restores a model from a source bundle with optional lexical-payload
     * clearing on fallback.
     */
    public ${Util.firstToUpper($model.grammarName)}Model restoreFromSourceBundle(${Util.firstToUpper($model.grammarName)}SourceBundle bundle, boolean clearLexicalPayloadOnFallback) {
        if(bundle == null) {
            throw new IllegalArgumentException("Source bundle must not be null.");
        }

        ${Util.firstToUpper($model.grammarName)}Model storedModel = bundle.getModel();
        if(storedModel == null) {
            throw new IllegalArgumentException("Source bundle does not contain a model.");
        }

        String sourceText = bundle.getSourceText();
        if(sourceText != null) {
            try {
                ${Util.firstToUpper($model.grammarName)}Model reparsedModel = parseStrictForSourceBundle(sourceText);
                if(semanticModelsMatch(reparsedModel, storedModel)) {
                    return reparsedModel;
                }
            } catch(RuntimeException ex) {
                // Source text is no longer parseable for this grammar. Fall back
                // to the stored semantic model below.
            }
        }

        if(clearLexicalPayloadOnFallback) {
            clearVMFTextLexicalPayload(storedModel);
        }
        return storedModel;
    }

    private ${Util.firstToUpper($model.grammarName)}Model parseStrictForSourceBundle(String sourceText) {
        ${Util.firstToUpper($model.grammarName)}ModelParser strictParser = new ${Util.firstToUpper($model.grammarName)}ModelParser();
        strictParser.setConsoleOutputDisabled(true);
        strictParser.setErrorHandler(new org.antlr.v4.runtime.BailErrorStrategy());
        strictParser.getErrorListeners().add(new org.antlr.v4.runtime.BaseErrorListener() {
            @Override
            public void syntaxError(org.antlr.v4.runtime.Recognizer<?, ?> recognizer, Object offendingSymbol,
                                    int line, int charPositionInLine, String msg,
                                    org.antlr.v4.runtime.RecognitionException e) {
                throw new RuntimeException("Cannot restore source bundle because source text is not parseable at "
                        + line + ":" + charPositionInLine + ": " + msg, e);
            }
        });
        return strictParser.parse(sourceText);
    }

    private boolean semanticModelsMatch(${Util.firstToUpper($model.grammarName)}Model reparsedModel,
                                        ${Util.firstToUpper($model.grammarName)}Model storedModel) {
        if(reparsedModel == null || storedModel == null) {
            return false;
        }

        if(!reparsedModel.equals(storedModel)) {
            return false;
        }

        // VMF equality is the primary semantic test. The canonical unparse with
        // lexical preservation disabled is an additional guard against stale
        // source text for grammars whose equality does not fully account for all
        // primitive/external values.
        try {
            return canonicalSemanticText(reparsedModel).equals(canonicalSemanticText(storedModel));
        } catch(RuntimeException ex) {
            return false;
        }
    }

    private String canonicalSemanticText(${Util.firstToUpper($model.grammarName)}Model model) {
        ${modelPackageName}.unparser.${Util.firstToUpper($model.grammarName)}ModelUnparser unparser =
                new ${modelPackageName}.unparser.${Util.firstToUpper($model.grammarName)}ModelUnparser();
        unparser.setFormatter(${modelPackageName}.unparser.Formatter.newDefaultFormatterWithoutLexicalPreservation());
        return unparser.unparse(model);
    }

    public void clearVMFTextLexicalPayload(${Util.firstToUpper($model.grammarName)}Model model) {
        if(model == null || model.getRoot() == null) {
            return;
        }

        model.getRoot().vmf().content().stream(CodeElement.class).forEach(e -> {
            e.setLexicalInfo(null);
        });
    }

    public ${Util.firstToUpper($model.grammarName)}Model parse(InputStream codeStream) throws IOException {

        CharStream input = CharStreams.fromStream(codeStream);

        ${Util.firstToUpper($model.grammarName)}Lexer lexer = new ${Util.firstToUpper($model.grammarName)}Lexer(input);

        for(ANTLRErrorListener l : errorListeners) {
            lexer.addErrorListener(l);
        }

        if(isConsoleOutputDisabled()) {
            lexer.removeErrorListener(org.antlr.v4.runtime.ConsoleErrorListener.INSTANCE);
        }

        CommonTokenStream tokens = new CommonTokenStream(lexer);
        ${Util.firstToUpper($model.grammarName)}Parser parser = new ${Util.firstToUpper($model.grammarName)}Parser(tokens);

        if(errorHandler!=null) {
            parser.setErrorHandler(errorHandler);
        }

        for(ANTLRErrorListener l : errorListeners) {
            parser.addErrorListener(l);
        }

        if(isConsoleOutputDisabled()) {
            parser.removeErrorListener(org.antlr.v4.runtime.ConsoleErrorListener.INSTANCE);
        }

        ${model.rootClass().nameWithUpper()}Context rootCtx = parser.${model.rootClass().name}();
        ${Util.firstToUpper($model.grammarName)}Model result = parse(rootCtx);
        addHiddenTextToModel(result.getRoot(), parser, tokens, rootCtx);

        return result;
    }

    private void addWhiteSpaceInFrontOfElementIfNotAlreadyPresent(CodeElement e) {
        if(e!=null && e.getLexicalInfo()!=null) {
            java.util.List<TriviaPiece> triviaPieces = e.getLexicalInfo().getTriviaPieces();
            if(!triviaPieces.isEmpty()) {
                TriviaPiece first = triviaPieces.get(0);
                if(first.getText().isEmpty()) {
                    first.setText(" ");
                }
            }
        }
    }

    private void registerIgnoredPiecesOfTextChangeListener(CodeElement element) {
        // replace ignored-pieces-of-text info if a property backed by terminal/lexer rule
        // (non-model type) has been changed
        // TODO 08.10.2018 maybe analyze the grammar to check whether we can reuse the information
        // Re-entrancy guard: splicing/clearing triviaPieces fires nested change events;
        // those must not be treated as semantic edits.
        final boolean[] mutatingTrivia = new boolean[]{false};
        element.vmf().changes().addListener((evt)->{

            if(mutatingTrivia[0]) {
                return;
            }

            // Only react to changes on this CodeElement. Contained objects
            // (LexicalInfo, TriviaPiece, …) also bubble here.
            if(evt.object() != element) {
                return;
            }

            // ignore changes to parent (irrelevant for hidden text)
            if("parent".equals(evt.propertyName())) {
                return;
            }

            // ignore typed lexical-metadata mutations (e.g. whitespace padding for
            // newly inserted model elements must not invalidate existing trivia)
            if("lexicalInfo".equals(evt.propertyName())) {
                return;
            }

            boolean isModelType = element.vmf().reflect().propertyByName(evt.propertyName()).
                    map(p->p.getType().isModelType()).orElse(false);
            // if the added object(s) is/are model types, we must ensure that there's at least one ws
            // between them and the objects unparsed directly prior to us to prevent potential
            // parse erros.
            //
            // For example:
            //
            // we could end up with two INT's merged together without any
            // space between them.
            //
            // TODO 08.10.2018 we could analyze the rules whether such an accidental merge could happen, e.g.
            // by checking ebnf-multiplicity ('+' and '*').
            if(isModelType) {
                // if the property is a single object, it's simple, we just add one ws in front of the
                // ignored-pieces-of-text info
                if(evt.getType() == eu.mihosoft.vmf.runtime.core.Change.ChangeType.PROPERTY) {
                    // retrieve the element
                    CodeElement e = evt.propertyChange().map(pC->pC.newValue()).
                            filter(pC->pC instanceof CodeElement).map(pC->(CodeElement)pC).orElse(null);
                    // add ws to the ignored-pieces-of-text info
                    // (if present and no space already in front of it)
                    addWhiteSpaceInFrontOfElementIfNotAlreadyPresent(e);
                } else if(evt.getType() == eu.mihosoft.vmf.runtime.core.Change.ChangeType.LIST) {
                    eu.mihosoft.vcollections.VListChangeEvent<?> listChange =
                            evt.listChange().orElse(null);
                    if(listChange != null && listChange.wasSet()) {
                        // in-place replace of a child: keep parent trivia; ensure WS on new child
                        listChange.added().elements().stream().
                                filter(o->o instanceof CodeElement).map(o->(CodeElement)o).
                                forEach(codeElement -> addWhiteSpaceInFrontOfElementIfNotAlreadyPresent(codeElement));
                        return;
                    }
                    mutatingTrivia[0] = true;
                    try {
                        // Splice parent bracket/comma trivia for '[ a (',' a)* ]' / '{ a (',' a)* }'
                        // shapes; fall back to add-only WS padding if unrecognized.
                        boolean spliced = spliceModelTypedDelimitedListTrivia(
                                element, evt.propertyName(), listChange);
                        if(!spliced) {
                            if(listChange != null) {
                                listChange.added().elements().stream().
                                        filter(o->o instanceof CodeElement).map(o->(CodeElement)o).
                                        forEach(codeElement -> addWhiteSpaceInFrontOfElementIfNotAlreadyPresent(codeElement));
                            }
                        } else if(listChange != null) {
                            listChange.added().elements().stream().
                                    filter(o->o instanceof CodeElement).map(o->(CodeElement)o).
                                    forEach(codeElement -> addWhiteSpaceInFrontOfElementIfNotAlreadyPresent(codeElement));
                        }
                    } finally {
                        mutatingTrivia[0] = false;
                    }
                }
            } else {
                // Non-model (primitive/string) edits: token *text* comes from the
                // property value on unparse; trivia only stores hidden text *before*
                // each terminal. Keep trivia when the terminal footprint is unchanged
                // (in-place list set / non-null property rewrite). For structural
                // head-separator list add/remove (bare or parenthesized
                // 'item (',' item)*'), splice trivia slots; otherwise clear.
                if(element.getLexicalInfo()==null) {
                    return;
                }
                if(evt.getType() == eu.mihosoft.vmf.runtime.core.Change.ChangeType.LIST) {
                    eu.mihosoft.vcollections.VListChangeEvent<?> listChange =
                            evt.listChange().orElse(null);
                    if(listChange != null && listChange.wasSet()) {
                        // in-place value rewrite: keep trivia; drop original lexeme
                        // for the replaced index so unparse uses the converter.
                        invalidateOriginalLexemes(element, evt.propertyName(), listChange);
                        return;
                    }
                    mutatingTrivia[0] = true;
                    try {
                        if(!spliceDelimitedPrimitiveListTrivia(
                                element, evt.propertyName(), listChange)) {
                            element.getLexicalInfo().getTriviaPieces().clear();
                        }
                        spliceOriginalLexemesForListChange(element, evt.propertyName(), listChange);
                    } finally {
                        mutatingTrivia[0] = false;
                    }
                    return;
                }
                if(evt.getType() == eu.mihosoft.vmf.runtime.core.Change.ChangeType.PROPERTY) {
                    eu.mihosoft.vmf.runtime.core.PropertyChange propertyChange =
                            evt.propertyChange().orElse(null);
                    if(propertyChange != null
                            && propertyChange.oldValue() != null
                            && propertyChange.newValue() != null) {
                        invalidateOriginalLexeme(element, evt.propertyName(), -1);
                        return;
                    }
                    // null↔value: update optional presence; preserve leading trivia so
                    // rule keywords keep their inter-rule whitespace. Value→null leaves
                    // states alone (unparser skips property-required optional groups).
                    if(propertyChange != null
                            && (propertyChange.oldValue() == null)
                            != (propertyChange.newValue() == null)) {
                        mutatingTrivia[0] = true;
                        try {
                            updateOptionalPresenceForNullValueToggle(
                                    element, propertyChange.newValue() != null);
                            invalidateOriginalLexeme(element, evt.propertyName(), -1);
                        } finally {
                            mutatingTrivia[0] = false;
                        }
                        return;
                    }
                }
                mutatingTrivia[0] = true;
                try {
                    element.getLexicalInfo().getTriviaPieces().clear();
                } finally {
                    mutatingTrivia[0] = false;
                }
            }
        }, false);
    }

    /**
     * Surgical trivia splice for delimited primitive lists:
     * <ul>
     *   <li>Bare {@code item (',' item)* [EOF]} — {@code size == 2N} or {@code 2N+1}
     *       (prefix {@code P=0})</li>
     *   <li>Parenthesized {@code '(' item (',' item)* ')' [EOF]} —
     *       {@code size == 2N+2} or {@code 2N+3} (prefix {@code P=1})</li>
     * </ul>
     * Footprint {@code F = size - 2N} distinguishes the shapes. Supports single-
     * and multi-index add/remove. Returns {@code false} when the pattern does not
     * match so the caller can {@code clear()}.
     */
    private boolean spliceDelimitedPrimitiveListTrivia(
            CodeElement element,
            String propertyName,
            eu.mihosoft.vcollections.VListChangeEvent<?> listChange) {

        if(listChange == null || element.getLexicalInfo() == null) {
            return false;
        }

        boolean added = listChange.wasAdded();
        boolean removed = listChange.wasRemoved();
        if(added == removed) {
            return false;
        }

        int[] indices = added
                ? listChange.added().indices()
                : listChange.removed().indices();
        if(indices == null || indices.length == 0) {
            return false;
        }

        java.util.List<?> list = listChange.source();
        int nAfter = list.size();
        int delta = indices.length;
        int nBefore = added ? nAfter - delta : nAfter + delta;
        // Allow nBefore==0 (add into empty) and nAfter==0 (remove last item).
        if(nBefore < 0 || nAfter < 0) {
            return false;
        }

        java.util.List<TriviaPiece> trivia =
                element.getLexicalInfo().getTriviaPieces();

        ListShapeHint hint = findListShapeHint(element, propertyName);
        if(hint != null && "PRIMITIVE_DELIMITED".equals(hint.getKind())) {
            int P = hint.getPrefixCount();
            int S = hint.getSuffixCount();
            int K = Math.max(0, hint.getSeparatorCount());
            int base = computeTriviaBaseForList(element, hint);
            int expectedLocal = primitiveLocalSize(nBefore, P, S, K);
            if(base < 0 || base + expectedLocal > trivia.size()) {
                // Refuse whole-trivia fallback so multi-list siblings stay intact.
                return false;
            }
            return splicePrimitiveListInRange(
                    trivia, base, P, S, K, nBefore, nAfter, added, indices);
        }

        // Heuristic (no hint): assume single-terminal separators (K=1).
        if(nBefore == 0) {
            // Empty window is pure prefix+suffix — try paren then bare.
            if(trivia.size() >= 2) {
                return splicePrimitiveListInRange(
                        trivia, 0, 1, trivia.size() - 1, 1,
                        nBefore, nAfter, added, indices);
            }
            if(trivia.size() >= 1) {
                return splicePrimitiveListInRange(
                        trivia, 0, 0, trivia.size(), 1,
                        nBefore, nAfter, added, indices);
            }
            return false;
        }
        int footprint = trivia.size() - 2 * nBefore;
        final int P;
        final int S;
        if(footprint == 0 || footprint == 1) {
            P = 0;
            S = footprint + 1; // size = n+(n-1)+S = 2n-1+S ⇒ S=footprint+1
        } else if(footprint == 2 || footprint == 3) {
            P = 1;
            S = footprint; // size = 1+n+(n-1)+S = 2n+S ⇒ S=footprint
        } else {
            return false;
        }
        return splicePrimitiveListInRange(
                trivia, 0, P, S, 1, nBefore, nAfter, added, indices);
    }

    /** {@code prefix + n + (n-1)*K + suffix} for primitive lists. */
    private static int primitiveLocalSize(int n, int P, int S, int K) {
        if(n <= 0) {
            return P + S;
        }
        return P + n + (n - 1) * K + S;
    }

    /**
     * Splices a primitive list window.
     * Layout: {@code [P prefix][val][sep×K]…[val][S suffix]}.
     */
    private boolean splicePrimitiveListInRange(
            java.util.List<TriviaPiece> trivia,
            int base,
            int P,
            int S,
            int K,
            int nBefore,
            int nAfter,
            boolean added,
            int[] indices) {

        int stride = 1 + K; // value + following separator terminals

        if(!added) {
            if(nBefore < 1) {
                return false;
            }
            int[] sorted = indices.clone();
            java.util.Arrays.sort(sorted);
            int nNow = nBefore;
            for(int k = sorted.length - 1; k >= 0; k--) {
                int i = sorted[k];
                if(i < 0 || i >= nNow) {
                    return false;
                }
                int localSize = primitiveLocalSize(nNow, P, S, K);
                if(trivia.size() < base + localSize) {
                    return false;
                }
                final int start;
                final int count;
                if(i == 0) {
                    start = base + P;
                    // Last remaining item: drop only its value slot; keep P/S.
                    count = (nNow > 1) ? stride : 1;
                } else {
                    // K seps before value i + the value
                    start = base + P + i * stride - K;
                    count = stride;
                }
                if(start < 0 || start + count > trivia.size()) {
                    return false;
                }
                removeTriviaRange(trivia, start, count);
                nNow--;
                if(i == 0 && K > 0 && nNow > 0 && base + P < trivia.size()) {
                    TriviaPiece head = trivia.get(base + P);
                    if("LIST_INSERT_PADDING".equals(head.getKind())) {
                        head.setText("");
                        head.setKind(classifyTriviaKind(""));
                    }
                }
            }
            return nNow == nAfter;
        }

        int[] sorted = indices.clone();
        java.util.Arrays.sort(sorted);
        int applied = 0;
        for(int raw : sorted) {
            int i = raw;
            if(i < 0 || i > nBefore + applied) {
                return false;
            }
            int nNow = nBefore + applied;
            if(nNow == 0) {
                // Empty → first item: insert a single value slot inside P…S.
                if(i != 0) {
                    return false;
                }
                trivia.add(base + P, newTriviaPiece(""));
                applied++;
                continue;
            }
            if(i == 0) {
                TriviaPiece formerHead = trivia.get(base + P);
                boolean formerHasText = formerHead.getText() != null
                        && !formerHead.getText().isEmpty();
                // New value slot, then K separator slots (if any neighbor follows).
                // Later separator terminals (e.g. 'and' after ',') get a leading
                // space so multi-token separators do not glue.
                trivia.add(base + P, newTriviaPiece(""));
                for(int s = 0; s < K; s++) {
                    trivia.add(base + P + 1 + s,
                            newTriviaPiece(s == 0 ? "" : " "));
                }
                if(formerHasText) {
                    TriviaPiece newHead = trivia.get(base + P);
                    newHead.setText(" ");
                    newHead.setKind("LIST_INSERT_PADDING");
                } else if(K > 0) {
                    TriviaPiece afterFirstSep = trivia.get(base + P + 1 + K);
                    if(afterFirstSep.getText() == null
                            || afterFirstSep.getText().isEmpty()) {
                        afterFirstSep.setText(" ");
                        afterFirstSep.setKind("LIST_INSERT_PADDING");
                    }
                } else if(base + P + 1 < trivia.size()) {
                    TriviaPiece next = trivia.get(base + P + 1);
                    if(next.getText() == null || next.getText().isEmpty()) {
                        // item+: ensure a space before the former head value
                        TriviaPiece newHead = trivia.get(base + P);
                        newHead.setText(" ");
                        newHead.setKind("LIST_INSERT_PADDING");
                    }
                }
            } else if(i >= nNow) {
                // Append after last value: K separator slots + new value slot.
                int insertAt = (K == 0)
                        ? (base + P + nNow)
                        : (base + P + (nNow - 1) * stride + 1);
                for(int s = 0; s < K; s++) {
                    trivia.add(insertAt + s,
                            newTriviaPiece(s == 0 ? "" : " "));
                }
                trivia.add(insertAt + K, newTriviaPiece(" "));
            } else {
                int insertAt = (K == 0)
                        ? (base + P + i)
                        : (base + P + i * stride - K);
                for(int s = 0; s < K; s++) {
                    trivia.add(insertAt + s,
                            newTriviaPiece(s == 0 ? "" : " "));
                }
                trivia.add(insertAt + K, newTriviaPiece(" "));
            }
            applied++;
        }
        return true;
    }

    private static void removeTriviaRange(
            java.util.List<TriviaPiece> trivia, int start, int count) {
        if(count <= 0) {
            return;
        }
        java.util.List<TriviaPiece> kept =
                new java.util.ArrayList<>(trivia.size() - count);
        for(int t = 0; t < trivia.size(); t++) {
            if(t < start || t >= start + count) {
                kept.add(trivia.get(t));
            }
        }
        trivia.clear();
        trivia.addAll(kept);
    }

    private ListShapeHint findListShapeHint(CodeElement element, String propertyName) {
        if(element.getLexicalInfo() == null || propertyName == null) {
            return null;
        }
        for(ListShapeHint h : element.getLexicalInfo().getListShapeHints()) {
            if(propertyName.equals(h.getPropertyName())) {
                return h;
            }
        }
        return null;
    }

    /**
     * Trivia index where {@code hint}'s list segment begins, based on sibling
     * list sizes and earlier hints' prefix/suffix/separator counts.
     */
    private int computeTriviaBaseForList(CodeElement element, ListShapeHint hint) {
        if(element.getLexicalInfo() == null) {
            return 0;
        }
        int base = 0;
        for(ListShapeHint h : element.getLexicalInfo().getListShapeHints()) {
            if(h.getOrderIndex() >= hint.getOrderIndex()) {
                break;
            }
            int n = listPropertySize(element, h.getPropertyName());
            if(n < 0) {
                return -1;
            }
            int P = h.getPrefixCount();
            int S = h.getSuffixCount();
            int K = Math.max(0, h.getSeparatorCount());
            if("PRIMITIVE_DELIMITED".equals(h.getKind())) {
                base += primitiveLocalSize(n, P, S, K);
            } else if("MODEL_DELIMITED".equals(h.getKind())) {
                base += modelLocalSize(n, P, S, K);
            }
        }
        return base;
    }

    /** Parent-only trivia size for model-typed lists. */
    private static int modelLocalSize(int n, int P, int S, int K) {
        if(n <= 0) {
            return P + S;
        }
        return P + (n - 1) * K + S;
    }

    private int listPropertySize(CodeElement element, String propertyName) {
        try {
            return element.vmf().reflect().propertyByName(propertyName).map(p -> {
                Object v = p.get();
                if(v instanceof java.util.Collection) {
                    return ((java.util.Collection<?>) v).size();
                }
                return -1;
            }).orElse(-1);
        } catch(Exception ex) {
            return -1;
        }
    }

    private void attachListShapeHints(CodeElement e, LexicalInfo lexicalInfo) {
#foreach($h in $listShapeHints)
        if(e instanceof ${h.ruleClassName}) {
            lexicalInfo.getListShapeHints().add(ListShapeHint.newBuilder().
                    withPropertyName("${h.propertyName}").
                    withKind("${h.kind}").
                    withPrefixCount(${h.prefixCount}).
                    withSuffixCount(${h.suffixCount}).
                    withSeparatorCount(${h.separatorCount}).
                    withOrderIndex(${h.orderIndex}).
                    withModelTyped(${h.modelTyped}).
                    build());
        }
#end
    }

    private TriviaPiece newTriviaPiece(String text) {
        return TriviaPiece.newBuilder().
                withText(text).
                withKind(classifyTriviaKind(text)).
                build();
    }

    /**
     * Updates lexical metadata when a non-model property toggles between
     * {@code null} and a value (typical optional {@code name=ID} inside
     * {@code ('(' name ')')?}).
     * <ul>
     *   <li>null→value with recorded optional states: mark them present and
     *       insert an empty trivia slot for the new terminal before the
     *       closing-delimiter slot</li>
     *   <li>null→value with no recorded states (fully absent group): record a
     *       wildcard {@code OptionalState} ({@code path="*"}) so the formatter
     *       treats all optionals on this element as present, and ensure trivia
     *       slots for {@code '(' value ')'}</li>
     *   <li>value→null: leave trivia and states intact so leading whitespace
     *       survives; the unparser skips property-required optional groups</li>
     * </ul>
     */
    private void updateOptionalPresenceForNullValueToggle(
            CodeElement element, boolean toValue) {

        if(!toValue || element.getLexicalInfo() == null) {
            return;
        }

        LexicalInfo info = element.getLexicalInfo();
        java.util.List<OptionalState> states = info.getOptionalStates();
        java.util.List<TriviaPiece> trivia = info.getTriviaPieces();

        if(states != null && !states.isEmpty()) {
            for(OptionalState s : states) {
                s.setPresent(true);
            }
            // Insert a slot for the newly present value terminal before the
            // last existing slot (usually the closing ')' / pad carrier).
            if(trivia.size() >= 2) {
                trivia.add(trivia.size() - 1, newTriviaPiece(""));
            } else {
                trivia.add(newTriviaPiece(""));
            }
            return;
        }

        // Fully absent optional group: no path-keyed states were recorded.
        // Wildcard present state forces the formatter to emit optional terminals;
        // ensure a 4-slot trivia footprint:
        //   [leading][before '('][before value][before ')']
        info.getOptionalStates().clear();
        info.getOptionalStates().add(OptionalState.newBuilder().
                withGrammarElementPath("*").
                withOccurrenceIndex(0).
                withPresent(true).
                build());
        if(trivia.isEmpty()) {
            trivia.add(newTriviaPiece(""));
        }
        if(trivia.size() == 1) {
            trivia.add(newTriviaPiece(" "));
            trivia.add(newTriviaPiece(""));
            trivia.add(newTriviaPiece(""));
        } else if(trivia.size() == 2) {
            trivia.add(newTriviaPiece(""));
            trivia.add(newTriviaPiece(""));
        } else if(trivia.size() == 3) {
            trivia.add(trivia.size() - 1, newTriviaPiece(""));
        }
    }

    private void invalidateOriginalLexeme(
            CodeElement element, String propertyName, int index) {
        if(element.getLexicalInfo() == null || propertyName == null) {
            return;
        }
        java.util.List<OriginalLexeme> lexemes =
                element.getLexicalInfo().getOriginalLexemes();
        lexemes.removeIf(lex -> propertyName.equals(lex.getPropertyName())
                && lex.getIndex() == index);
    }

    private void invalidateOriginalLexemes(
            CodeElement element, String propertyName,
            eu.mihosoft.vcollections.VListChangeEvent<?> listChange) {
        if(element.getLexicalInfo() == null || propertyName == null
                || listChange == null) {
            return;
        }
        int[] indices = listChange.added().indices();
        if(indices == null) {
            indices = listChange.removed().indices();
        }
        if(indices == null) {
            return;
        }
        for(int i : indices) {
            invalidateOriginalLexeme(element, propertyName, i);
        }
    }

    private void spliceOriginalLexemesForListChange(
            CodeElement element, String propertyName,
            eu.mihosoft.vcollections.VListChangeEvent<?> listChange) {
        if(element.getLexicalInfo() == null || propertyName == null
                || listChange == null) {
            return;
        }
        java.util.List<OriginalLexeme> lexemes =
                element.getLexicalInfo().getOriginalLexemes();
        boolean added = listChange.wasAdded();
        boolean removed = listChange.wasRemoved();
        if(added == removed) {
            return;
        }
        int[] indices = added
                ? listChange.added().indices()
                : listChange.removed().indices();
        if(indices == null || indices.length == 0) {
            return;
        }
        int[] sorted = indices.clone();
        java.util.Arrays.sort(sorted);
        if(removed) {
            for(int k = sorted.length - 1; k >= 0; k--) {
                int i = sorted[k];
                lexemes.removeIf(lex -> propertyName.equals(lex.getPropertyName())
                        && lex.getIndex() == i);
                for(OriginalLexeme lex : lexemes) {
                    if(propertyName.equals(lex.getPropertyName())
                            && lex.getIndex() > i) {
                        lex.setIndex(lex.getIndex() - 1);
                    }
                }
            }
        } else {
            for(int i : sorted) {
                for(OriginalLexeme lex : lexemes) {
                    if(propertyName.equals(lex.getPropertyName())
                            && lex.getIndex() >= i) {
                        lex.setIndex(lex.getIndex() + 1);
                    }
                }
                // Newly inserted values have no original lexeme (converter text).
            }
        }
    }

    /**
     * Surgical parent-trivia splice for model-typed delimited lists.
     * Parent holds only prefix/separator/suffix slots (child leading WS lives
     * on each item). Uses {@link ListShapeHint#getSeparatorCount()} so
     * multi-token separators and separator-less {@code item+} are covered.
     */
    private boolean spliceModelTypedDelimitedListTrivia(
            CodeElement element,
            String propertyName,
            eu.mihosoft.vcollections.VListChangeEvent<?> listChange) {

        if(listChange == null || element.getLexicalInfo() == null) {
            return false;
        }

        boolean added = listChange.wasAdded();
        boolean removed = listChange.wasRemoved();
        if(added == removed) {
            return false;
        }

        int[] indices = added
                ? listChange.added().indices()
                : listChange.removed().indices();
        if(indices == null || indices.length == 0) {
            return false;
        }

        java.util.List<?> list = listChange.source();
        int nAfter = list.size();
        int delta = indices.length;
        int nBefore = added ? nAfter - delta : nAfter + delta;
        if(nBefore < 0 || nAfter < 0) {
            return false;
        }

        java.util.List<TriviaPiece> trivia =
                element.getLexicalInfo().getTriviaPieces();

        int base = 0;
        int P;
        int S;
        int K;
        ListShapeHint hint = findListShapeHint(element, propertyName);
        if(hint != null && "MODEL_DELIMITED".equals(hint.getKind())) {
            base = computeTriviaBaseForList(element, hint);
            if(base < 0) {
                return false;
            }
            P = hint.getPrefixCount();
            S = hint.getSuffixCount();
            K = Math.max(0, hint.getSeparatorCount());
            if(K == 0) {
                // item+: parent has no inter-item terminals — keep trivia as-is.
                return true;
            }
            int expectedLocal = modelLocalSize(nBefore, P, S, K);
            if(base + expectedLocal > trivia.size()) {
                return false;
            }
            return spliceModelTypedListInRange(
                    trivia, base, P, S, K, nBefore, nAfter, added, indices);
        }

        // Heuristic: bracketed K=1 (JSON) or bare K=1.
        if(trivia.size() == modelLocalSize(nBefore, 1, 1, 1)) {
            return spliceModelTypedListInRange(
                    trivia, 0, 1, 1, 1, nBefore, nAfter, added, indices);
        }
        if(trivia.size() == modelLocalSize(nBefore, 0, 1, 1)) {
            return spliceModelTypedListInRange(
                    trivia, 0, 0, 1, 1, nBefore, nAfter, added, indices);
        }
        return false;
    }

    /**
     * Parent layout: {@code [P prefix][sep×K]…[sep×K][S suffix]} (no value slots).
     * Insert/remove adjusts exactly {@code K} separator slots per structural op.
     */
    private boolean spliceModelTypedListInRange(
            java.util.List<TriviaPiece> trivia,
            int base,
            int P,
            int S,
            int K,
            int nBefore,
            int nAfter,
            boolean added,
            int[] indices) {

        if(K <= 0) {
            return true;
        }
        int expectedBefore = modelLocalSize(nBefore, P, S, K);
        if(trivia.size() < base + expectedBefore) {
            return false;
        }

        if(!added) {
            int[] sorted = indices.clone();
            java.util.Arrays.sort(sorted);
            int nNow = nBefore;
            for(int k = sorted.length - 1; k >= 0; k--) {
                int i = sorted[k];
                if(i < 0 || i >= nNow) {
                    return false;
                }
                int expectedNow = modelLocalSize(nNow, P, S, K);
                if(trivia.size() < base + expectedNow) {
                    return false;
                }
                if(nNow == 1) {
                    // Last element: no separator group to drop (leave brackets/pad).
                    nNow = 0;
                    continue;
                }
                // Separator group coupling item i to a neighbor starts at:
                //   i==0 → first group after prefix; else group before item i.
                int sepAt = base + P + ((i == 0) ? 0 : (i - 1) * K);
                if(i == nNow - 1) {
                    sepAt = base + P + (nNow - 2) * K;
                }
                if(sepAt < base + P
                        || sepAt + K > base + expectedNow - S) {
                    // Allow S==0 edge; still require the K slots to exist.
                    if(sepAt < base || sepAt + K > trivia.size()) {
                        return false;
                    }
                }
                removeTriviaRange(trivia, sepAt, K);
                nNow--;
            }
            return nNow == nAfter
                    && trivia.size() >= base + modelLocalSize(nAfter, P, S, K);
        }

        int[] sorted = indices.clone();
        java.util.Arrays.sort(sorted);
        int applied = 0;
        for(int i : sorted) {
            int nNow = nBefore + applied;
            int expectedNow = modelLocalSize(nNow, P, S, K);
            if(trivia.size() < base + expectedNow) {
                return false;
            }
            if(nNow == 0) {
                if(i != 0) {
                    return false;
                }
                applied++;
                continue;
            }
            if(i < 0 || i > nNow) {
                return false;
            }
            int sepAt;
            if(i >= nNow) {
                // Append: insert separator group before suffix.
                sepAt = base + expectedNow - S;
            } else if(i == 0) {
                sepAt = base + P;
            } else {
                sepAt = base + P + i * K;
            }
            // Mark insert-at-0 separator so remove(0) drops it and restores the
            // former first separator's leading WS (bare model undo).
            for(int s = 0; s < K; s++) {
                TriviaPiece piece = newTriviaPiece("");
                if(i == 0 && s == 0) {
                    piece.setKind("LIST_INSERT_PADDING");
                }
                trivia.add(sepAt + s, piece);
            }
            applied++;
        }
        return trivia.size() >= base + modelLocalSize(nAfter, P, S, K);
    }

    /**
     * Adds hidden text to payloads for lexical preservation.
     */
    private void addHiddenTextToModel(
        CodeElement element,
        ${Util.firstToUpper($model.grammarName)}Parser parser, TokenStream tokens,
        ParserRuleContext ctx) {

        // collect ignored pieces of text for lexical preservation
        IgnoredPiecesOfTextListener ignoredPiecesOfTextListener =
          new IgnoredPiecesOfTextListener(tokens);

        ParseTreeWalker walker = new ParseTreeWalker();
        walker.walk(ignoredPiecesOfTextListener,ctx);

        // We need an additional string in case that EOF isn't present in the grammar.
        //
        // REASON:
        // - to prevent 'index out of bounds' exceptions
        // - in case the grammar doesn't end with EOF in which case we won't be able
        //   to parse the WS/hidden chars from the end of the rule to the end of the file.
        ignoredPiecesOfTextListener.getIgnoredPiecesOfText(ctx).add("");
        
        java.util.List<CodeElement> codeElement =
                element.vmf().content().stream(CodeElement.class).
                        collect(Collectors.toList());

        // go over each code element
        for(CodeElement e : codeElement) {

            // register listener to clear trivia info if terminal/lexer properties do change
            registerIgnoredPiecesOfTextChangeListener(e);

            ParserRuleContext eCtx = conversionRuleContexts.get(e);
            if(eCtx == null) {
                continue;
            }
                       
            java.util.List<String> ignoredPiecesOfText = ignoredPiecesOfTextListener.getIgnoredPiecesOfText(eCtx);
            java.util.List<String> optionalStateEntries = getOptionalStateEntryList(eCtx);

            LexicalInfo lexicalInfo = e.getLexicalInfo();
            if(lexicalInfo == null) {
                lexicalInfo = LexicalInfo.newInstance();
                e.setLexicalInfo(lexicalInfo);
            }
            lexicalInfo.getTriviaPieces().clear();
            for(String piece : ignoredPiecesOfText) {
                lexicalInfo.getTriviaPieces().add(TriviaPiece.newBuilder().
                        withText(piece).
                        withKind(classifyTriviaKind(piece)).
                        build());
            }
            lexicalInfo.getOptionalStates().clear();
            java.util.Map<String,Integer> optionalOccurrenceCounters =
                    new java.util.HashMap<>();
            for(String optionalStateEntry : optionalStateEntries) {
                int sepIdx = optionalStateEntry.lastIndexOf('=');
                String path = optionalStateEntry.substring(0, sepIdx);
                int occurrence = optionalOccurrenceCounters.getOrDefault(path, 0);
                optionalOccurrenceCounters.put(path, occurrence + 1);
                lexicalInfo.getOptionalStates().add(OptionalState.newBuilder().
                        withGrammarElementPath(path).
                        withOccurrenceIndex(occurrence).
                        withPresent(Boolean.parseBoolean(optionalStateEntry.substring(sepIdx+1))).
                        build());
            }
            lexicalInfo.getListShapeHints().clear();
            attachListShapeHints(e, lexicalInfo);
            lexicalInfo.setOriginalRange(e.getCodeRange());
            lexicalInfo.setGrammarElementPath(eCtx.getClass().getSimpleName());

        } // end for each code element

        conversionRuleContexts.clear();
    }

    private static String classifyTriviaKind(String piece) {
        if(piece == null || piece.isEmpty()) {
            return "WHITESPACE";
        }
        String trimmed = piece.trim();
        if(trimmed.startsWith("//") || trimmed.startsWith("/*") || trimmed.startsWith("*")) {
            return "COMMENT";
        }
        if(piece.chars().allMatch(ch -> Character.isWhitespace(ch))) {
            return "WHITESPACE";
        }
        return "OTHER";
    }

    private static java.util.List<String> getOptionalStateEntryList(ParserRuleContext ctx) {
        try {
            java.lang.reflect.Field field = ctx.getClass().getField("__vmf_text__optionalStates");
            Object value = field.get(ctx);
            return (java.util.List<String>) value;
        } catch (Exception ex) {
            throw new RuntimeException("Cannot read optional-state list from parser context "
                    + ctx.getClass().getSimpleName(), ex);
        }
    }



