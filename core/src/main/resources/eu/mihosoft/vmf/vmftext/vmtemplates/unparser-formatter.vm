/**
 * Text formatting interface.
 */
public interface Formatter {

  /**
   * Pushes the current state onto the stack.
   */
  default void pushState()   {}

  /**
   * Accepts the current state, i.e., pops the current state but merges its content to the parent state retrieved via peek().
   */
  default void acceptState() {}

  /**
   * Rejects the current state, i.e., pops the current state without retaining its content.
   */
  default void rejectState() {}

  /**
   * Called before the unparser starts rendering the specified code element
   * (mirror of {@link #done(CodeElement, boolean, PrintWriter)}).
   * @param e code element
   * @param w print writer used to render the element
   */
  default void begin(CodeElement e, PrintWriter w) {}

  /**
   * This method is called to indicate that the rendering of the specified code element is done.
   * @param e code element
   * @param success indicates whether unparsing was successful
   * @param w print writer that can be used to insert additional strings to the currently unparsed text
   */
  default void done(CodeElement e, boolean success, PrintWriter w) {}

  /**
   * Output ranges of the elements that were rendered without lexical
   * information during the last top-level unparse (programmatically created
   * elements and elements whose trivia was cleared by an edit), outermost
   * first. Everything outside these ranges reproduces the parsed input byte
   * for byte. Use them to run an external formatter on exactly these lines.
   * Formatters without lexical preservation return an empty list.
   */
  default java.util.List<OutputRange> programmaticRanges() { return java.util.Collections.emptyList(); }

  /** An output range: character offsets (end exclusive) and 1-based inclusive lines. */
  final class OutputRange {
    private final CodeElement element;
    private final int start, end, startLine, endLine;
    OutputRange(CodeElement element, int start, int end, int startLine, int endLine) {
      this.element = element; this.start = start; this.end = end; this.startLine = startLine; this.endLine = endLine;
    }
    public CodeElement getElement() { return element; }
    public int getStart() { return start; }
    public int getEnd() { return end; }
    public int getStartLine() { return startLine; }
    public int getEndLine() { return endLine; }
    @Override public String toString() { return element.getClass().getSimpleName() + "[" + start + "," + end + ") lines " + startLine + "-" + endLine; }
  }

  /**
   * Called prior to rendering an element. Can be used to insert additional text before rendering the
   * element. 
   * @param unparser the model unparser, i.e., top-level unparser
   * @param ruleInfo information about the rule that is currently rendered
   * @param w the print writer used to render the current element
   */
  default void pre( ${model.grammarName}ModelUnparser unparser, RuleInfo ruleInfo, PrintWriter w ){}

  /**
   * Renders an element. This method is called after the {@code pre()}-method and before the {@code post()}-method.
   *
   * @param unparser the model unparser, i.e., top-level unparser
   * @param ruleInfo information about the rule that is currently rendered
   * @param w the print writer used to render the current element
   * @param s the string representation of the current element (can be changed by the implementation of this method)
   */
  default void render(${model.grammarName}ModelUnparser unparser, RuleInfo ruleInfo, PrintWriter w, String s) {
    w.print(s);
  }

  /**
   * Called after rendering an element. Can be used to insert additional text after rendering the
   * element. 
   * @param unparser the model unparser, i.e., top-level unparser
   * @param ruleInfo information about the rule that is currently rendered
   * @param w the print writer used to render the current element
   */
  default void post(${model.grammarName}ModelUnparser unparser, RuleInfo ruleInfo, PrintWriter w ){}

  /**
   * Returns a new instance of the default formatter that supports lexical preservation, i.e., the default
   * formatter tries to reproduce white-spaces as accurately as possible.
   */
  static Formatter newDefaultFormatter() { return new DefaultFormatter();}

  /**
   * Returns a lexical-preserving formatter that consults the given policy only
   * where exact preservation is undefined (programmatically created nodes or
   * invalidated lexical metadata after edits).
   */
  static Formatter newDefaultFormatter(Formatter.ProgrammaticSeparatorPolicy policy) {
    return new DefaultFormatter(policy);
  }

  /**
   * What a {@link ProgrammaticSeparatorPolicy} may know about the output so
   * far when it is asked for a separator.
   */
  interface FormattingContext {
    /** text of the previously rendered terminal, or {@code null} at the start of the document */
    String previousTerminalText();
    /** number of model elements currently being rendered (the root counts as 1) */
    int elementDepth();
    /** true when nothing has been written yet or the last written character is a line break */
    boolean atLineStart();
    /** characters written so far */
    int position();
    /** 1-based line of the next character */
    int line();
  }

  /**
   * Policy consulted by {@link DefaultFormatter} only where exact lexical
   * preservation is undefined by construction. Implement the context-aware
   * variants to emit line breaks and indentation; the two-argument variants
   * remain for policies that only need the terminal.
   */
  interface ProgrammaticSeparatorPolicy {
    /**
     * Separator to emit before a terminal/lexer element when the parent carries
     * no lexical metadata at all (e.g. programmatically created models),
     * with context. Delegates to {@link #separatorBefore(CodeElement, RuleInfo)}.
     */
    default String separatorBefore(CodeElement parent, RuleInfo ruleInfo, FormattingContext ctx) {
      return separatorBefore(parent, ruleInfo);
    }
    /**
     * Separator to emit when lexical metadata was deliberately invalidated by
     * model edits, with context. Delegates to {@link #separatorBeforeEdited(CodeElement, RuleInfo)}.
     */
    default String separatorBeforeEdited(CodeElement parent, RuleInfo ruleInfo, FormattingContext ctx) {
      return separatorBeforeEdited(parent, ruleInfo);
    }
    /**
     * Notified for <em>every</em> rendered terminal, parsed or not, so a policy
     * can track structure (e.g. brace depth) across parsed regions it is never
     * asked about.
     * @param programmatic true when this terminal's separator came from this policy
     */
    default void terminal(RuleInfo ruleInfo, boolean programmatic) {}

    /**
     * Separator to emit before a terminal/lexer element when the parent carries
     * no lexical metadata at all (e.g. programmatically created models).
     */
    String separatorBefore(CodeElement parent, RuleInfo ruleInfo);

    /**
     * Separator to emit when lexical metadata was deliberately invalidated by
     * model edits (empty trivia list on a parent that still has lexical info).
     */
    String separatorBeforeEdited(CodeElement parent, RuleInfo ruleInfo);

    /**
     * Separator to emit when the hidden-text counter is exhausted before a
     * closing delimiter during best-effort unparsing of edited models.
     */
    String separatorBeforeClosingDelimiter(CodeElement parent, RuleInfo ruleInfo);
  }

  /**
   * Returns a new instance of the default formatte without support for lexical preservation. This
   * is recommended whenever the format of the textual representation isn't relevant and if performace is
   * crutial.
   */
  static Formatter newDefaultFormatterWithoutLexicalPreservation() { 
    return new DefaultFormatterWithoutLexicalPreservation();
  }

  /**
   * Returns a lexical-preserving formatter whose programmatic / edited parts
   * are printed with line breaks and block indentation
   * ({@link BlockIndentSeparatorPolicy} with its defaults: {@code {} ; } and
   * two spaces). Parsed bytes stay exact.
   */
  static Formatter newBlockIndentFormatter() { return new DefaultFormatter(new BlockIndentSeparatorPolicy()); }

  static enum RuleType {
    LEXER_RULE,
    TERMINAL,
    NONE
  }

  /**
   * This class stores information about the element rule to enable custom rendering behavior.
   */
  static final class RuleInfo {

    private final CodeElement parentObject;
    private final RuleType ruleType;
    private final String ruleName;
    private final String ruleText;

    // like xpath, i.e., /r37/a5/sr2 -> sub-rule 2 inside alternative 5 of rule 37
    private final String rulePath;

    // an unlabeled rule, i.e. a rule that's not represented as property
    private final boolean unnamed; 

    // indicates whether this rule is optional and its validity isn't defined by properties
    // Examples:
    // (1) name=IDENTIFIER ';'?
    // (2) ('(' assignments+=assignment* ')')?
    private final boolean optional; 

    // like (',' names+=IDENTIFIER)*  
    private final String grammarText;

    // consumed
    private boolean consumed;

    private RuleInfo(CodeElement parentObject, RuleType ruleType, String ruleName, String ruleText,
                     String rulePath, boolean unnamed, boolean optional, String grammarText) {
      this.parentObject = parentObject;
      this.ruleType = ruleType;
      this.ruleName = ruleName;
      this.ruleText = ruleText;

      this.rulePath = rulePath;
      this.unnamed  = unnamed;
      this.optional = optional;
      this.grammarText = grammarText;
    }

    public static RuleInfo emptyRule() {
      return new RuleInfo(
        new CodeElement() {
            @Override
            public CodeRange getCodeRange() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public void setCodeRange(CodeRange codeRange) {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public void setPayload(Object payload) {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public Object getPayload() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public void setLexicalInfo(LexicalInfo lexicalInfo) {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public LexicalInfo getLexicalInfo() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public void setRuleMapShellLexicalInfo(LexicalInfo ruleMapShellLexicalInfo) {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public LexicalInfo getRuleMapShellLexicalInfo() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public CodeElement getParent() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public void setParent(CodeElement parent) {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public CodeElement root() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public eu.mihosoft.vcollections.VList<CodeElement> pathToRoot() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public ReadOnlyCodeElement asReadOnly() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public VMF vmf() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public CodeElement clone() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }

            @Override
            public String asString() {
                throw new UnsupportedOperationException("Empty Code Element does not support this operation.");
            }
        }, RuleType.NONE, "","", "", true, false, "");
    }

   /**
    * Calling this method consumes the current rule. This method only has an effect if called inside
    * the {@code Formatter.pre()} method.
    */
    public void consume() {
      this.consumed = true;
    }

    boolean isConsumed() {
      return this.consumed;
    }

    /*package private*/ static RuleInfo newRuleInfo(CodeElement parentObject, RuleType ruleType, String ruleName, String ruleText, 
        String rulePath, boolean unnamed, boolean optional, String grammarText) {
      return new RuleInfo(parentObject, ruleType, ruleName, ruleText, rulePath, unnamed, optional, grammarText);
    }

    public CodeElement getParentObject() {
      return this.parentObject;
    }

    public RuleType getRuleType() {
      return this.ruleType;
    }

    public Optional<String> getRuleName() {
      return Optional.ofNullable(this.ruleName);
    }

    public String getRuleText() {
      return this.ruleText;
    }

    public String getRulePath() {
      return this.rulePath;
    }

    public boolean isUnnamed() {
      return this.unnamed;
    }

    public boolean isOptional() {
      return this.optional;
    }

    public String getGrammarText() {
      return this.grammarText;
    }


  }
}

// ------------------------------------------------------------
// DEFAULT FORMATTER (with lexical preservation and without) 
// ------------------------------------------------------------

  class DefaultFormatterWithoutLexicalPreservation implements Formatter {
    public void post(${model.grammarName}ModelUnparser unparser, RuleInfo ruleInfo, PrintWriter w ) {
      w.append(" ");
    }
  }

  class DefaultFormatter extends BaseFormatter {

    private final Formatter.ProgrammaticSeparatorPolicy programmaticPolicy;

    private CodeElement currentElement;

    private boolean consumeElement = false;
    // --- output tracking for the formatting context and programmatic ranges
    private int position = 0;
    private int line = 1;
    private char lastChar = 0;
    private String lastTerminalText = null;
    private int elementDepth = 0;
    private boolean lastSeparatorProgrammatic = false;
    private final java.util.Deque<CodeElement> openElements = new java.util.ArrayDeque<>();
    // elements rendered without lexical info: start position/line once the first terminal renders
    private final java.util.IdentityHashMap<CodeElement, int[]> pendingRanges = new java.util.IdentityHashMap<>();
    private final java.util.List<OutputRange> ranges = new java.util.ArrayList<>();
    private final Formatter.FormattingContext context = new Formatter.FormattingContext() {
        @Override public String previousTerminalText() { return lastTerminalText; }
        @Override public int elementDepth() { return elementDepth; }
        @Override public boolean atLineStart() { return position == 0 || lastChar == '\n'; }
        @Override public int position() { return position; }
        @Override public int line() { return line; }
    };

    /** every character this formatter writes goes through here */
    private void emit(PrintWriter w, String s) {
        if(s == null || s.isEmpty()) {
            return;
        }
        w.print(s);
        for(int i = 0; i < s.length(); i++) {
            if(s.charAt(i) == '\n') {
                line++;
            }
        }
        position += s.length();
        lastChar = s.charAt(s.length() - 1);
    }

    @Override
    public java.util.List<OutputRange> programmaticRanges() {
        return java.util.Collections.unmodifiableList(new java.util.ArrayList<>(ranges));
    }

    @Override
    public void begin(CodeElement e, PrintWriter w) {
        if(openElements.isEmpty()) {
            // a new document
            position = 0;
            line = 1;
            lastChar = 0;
            lastTerminalText = null;
            ranges.clear();
            pendingRanges.clear();
        }
        openElements.push(e);
        elementDepth = openElements.size();
        java.util.List<String> hidden = getHiddenText(e);
        if(hidden == null || hidden.isEmpty()) {
            pendingRanges.put(e, null); // start is set by the first rendered terminal
        }
    }

    private final java.util.IdentityHashMap<CodeElement, Integer> hiddenTextCounters =
            new java.util.IdentityHashMap<>();
    private final java.util.IdentityHashMap<CodeElement, java.util.Map<String,Integer>> optionalPathCounters =
            new java.util.IdentityHashMap<>();
    
    DefaultFormatter() {
        this(ConservativeSeparatorPolicy.INSTANCE);
    }

    DefaultFormatter(Formatter.ProgrammaticSeparatorPolicy programmaticPolicy) {
        this.programmaticPolicy = programmaticPolicy;
    }

    @Override
    public void done(CodeElement e, boolean success, PrintWriter w) {

      int[] started = pendingRanges.remove(e);
      if(started != null) {
        ranges.add(new OutputRange(e, started[0], position, started[1], line));
      }

      // Emit trailing hidden text only for the root element to avoid
      // introducing extra whitespace between nested elements and following tokens.
      if (e.getParent()==null) {
        int pos = getHiddenTextCounter(e);
        if(getHiddenText(e)!=null && pos < getHiddenText(e).size()) {
          String ws = getHiddenText(e).get(pos);
          emit(w, ws);
        }
      }

      // now reset the counter information for reconstructing WS info
      reset(e);
      currentElement = null;
      if(!openElements.isEmpty() && openElements.peek() == e) {
        openElements.pop();
      } else {
        openElements.remove(e);
      }
      elementDepth = openElements.size();
      if(openElements.isEmpty()) {
        // outermost first, and nested ranges after their parents
        ranges.sort((a, b) -> a.getStart() != b.getStart() ? Integer.compare(a.getStart(), b.getStart())
                                                             : Integer.compare(b.getEnd(), a.getEnd()));
      }
    }

    @Override
    public void rejectState() {
        super.rejectState();

        if(currentElement!=null) {
          reset(currentElement);
        }
    }

    @Override
    public void acceptState() {
        super.acceptState();

//        if(currentElement!=null) {
//          reset(currentElement);
//        }
    }

    private void incHiddenTextCounter(CodeElement e) {
        hiddenTextCounters.put(e, getHiddenTextCounter(e) + 1);
    }
    private void decHiddenTextCounter(CodeElement e) {
        hiddenTextCounters.put(e, getHiddenTextCounter(e) - 1);
    }
    private void reset(CodeElement e) {
        hiddenTextCounters.remove(e);
        optionalPathCounters.remove(e);
    }
    private int getHiddenTextCounter(CodeElement e) {
        Integer value = hiddenTextCounters.get(e);
        return value == null ? 0 : value;
    }
    private java.util.List<String> getHiddenText(CodeElement e) {

        if(e.getLexicalInfo()==null) {
          return null;
        }

        java.util.List<String> result = new java.util.ArrayList<>();
        for(TriviaPiece piece : e.getLexicalInfo().getTriviaPieces()) {
            result.add(piece.getText());
        }
        return result;
    }

    /**
     * True when {@code updateOptionalPresenceForNullValueToggle} recorded a
     * wildcard {@code path="*"} present state (fully absent group → value).
     */
    private boolean forceAllOptionalsPresent(CodeElement e) {
        if(e.getLexicalInfo()==null) {
            return false;
        }
        for(OptionalState s : e.getLexicalInfo().getOptionalStates()) {
            if("*".equals(s.getGrammarElementPath()) && s.isPresent()) {
                return true;
            }
        }
        return false;
    }

    /**
     * Heuristic: parsed elements carry an original range, trivia slots, and/or
     * a grammar-element path from {@code addHiddenTextToModel}. Programmatic
     * builders usually have none of these.
     */
    private boolean looksLikeParsedElement(CodeElement e) {
        if(e.getLexicalInfo()==null) {
            return false;
        }
        LexicalInfo info = e.getLexicalInfo();
        if(info.getOriginalRange() != null) {
            return true;
        }
        if(info.getTriviaPieces() != null && !info.getTriviaPieces().isEmpty()) {
            return true;
        }
        String path = info.getGrammarElementPath();
        return path != null && !path.isEmpty();
    }

    /**
     * Returns the recorded optional-presence states for the given grammar
     * element path, in occurrence order, or {@code null} if the element
     * carries no path-keyed states at all.
     * An empty list means path-keyed data exists but this path was never
     * recorded, i.e. the element is absent.
     */
    private java.util.List<Boolean> getOptionalStatesForPath(CodeElement e, String path) {

        if(e.getLexicalInfo()==null) {
          return null;
        }

        java.util.List<OptionalState> states = e.getLexicalInfo().getOptionalStates();

        if(states==null || states.isEmpty()) {
          return null;
        }

        java.util.List<Boolean> result = new java.util.ArrayList<>();
        for(OptionalState s : states) {
            if(path.equals(s.getGrammarElementPath())) {
                result.add(s.isPresent());
            }
        }
        return result;
    }

    private int getOptionalPathCounter(CodeElement e, String path) {
        java.util.Map<String,Integer> counters = optionalPathCounters.get(e);
        if(counters == null) {
            return 0;
        }
        Integer value = counters.get(path);
        return value==null ? 0 : value;
    }

    private void incOptionalPathCounter(CodeElement e, String path) {
        java.util.Map<String,Integer> counters = optionalPathCounters.get(e);
        if(counters == null) {
            counters = new java.util.HashMap<>();
            optionalPathCounters.put(e, counters);
        }
        Integer value = counters.get(path);
        counters.put(path, value==null ? 1 : value+1);
    }

    /**
     * Looks up a recorded optional state by path and occurrence index.
     * Returns {@code null} when no indexed state exists for that pair
     * (caller may fall back to encounter-order).
     */
    private Boolean findOptionalStateByOccurrence(
            CodeElement e, String path, int occurrenceIndex) {
        if(e.getLexicalInfo()==null) {
            return null;
        }
        boolean sawIndexed = false;
        for(OptionalState s : e.getLexicalInfo().getOptionalStates()) {
            if(!path.equals(s.getGrammarElementPath())) {
                continue;
            }
            if(s.getOccurrenceIndex() < 0) {
                continue;
            }
            sawIndexed = true;
            if(s.getOccurrenceIndex() == occurrenceIndex) {
                return s.isPresent();
            }
        }
        // Indexed states exist for this path but this occurrence was never
        // recorded → absent. (Repetitions grown by model edits do not reach
        // this code: terminals inside a property-driven repetition are not
        // optional for the formatter, see UPRuleUtil.isOptionalForFormatter.)
        return sawIndexed ? Boolean.FALSE : null;
    }

    @Override
    public void pre(${model.grammarName}ModelUnparser unparser, RuleInfo ruleInfo, PrintWriter w) {
        if(!(ruleInfo.getRuleType()==RuleType.TERMINAL || ruleInfo.getRuleType()==RuleType.LEXER_RULE)) {
            // Only terminals/lexer rules drive hidden-text consumption
            return;
        }

            consumeElement = false;

            CodeElement e = ruleInfo.getParentObject();
            currentElement = e;

            // skip effectively optional elements depending on state
            if(ruleInfo.isOptional()) {

                boolean symbolState = false;

                if(forceAllOptionalsPresent(e)) {
                  // null→value on a fully unrecorded optional group.
                  symbolState = true;
                } else {
                  java.util.List<Boolean> pathStates =
                          getOptionalStatesForPath(e, ruleInfo.getRulePath());

                  if(pathStates != null) {
                    // Prefer exact (path, occurrenceIndex) match when indices are
                    // recorded (>=0). Fall back to encounter-order for legacy
                    // states with occurrenceIndex < 0.
                    int pos = getOptionalPathCounter(e, ruleInfo.getRulePath());
                    Boolean indexed = findOptionalStateByOccurrence(
                            e, ruleInfo.getRulePath(), pos);
                    if(indexed != null) {
                      symbolState = indexed;
                    } else if(pos < pathStates.size()) {
                      symbolState = pathStates.get(pos);
                    } else {
                      symbolState = false;
                    }
                    incOptionalPathCounter(e, ruleInfo.getRulePath());
                  } else {
                    // No OptionalState entries at all. Parse often omits absent
                    // optionals entirely, so "empty states" is ambiguous:
                    //   - parsed element (range / trivia / path set) → absent
                    //   - programmatic bare model → present (pretty-print)
                    symbolState = !looksLikeParsedElement(e);
                  }
                }

                if(!symbolState) {
                  // Element is absent. Do NOT consume any hidden text here.
                  // We let adjacent real tokens handle whitespace reconstruction.
                  ruleInfo.consume();
                  consumeElement = true;
                  return;
                }
                // If the optional element is present, fall through to the regular hidden-text handling below
            }

            lastSeparatorProgrammatic = false;
            if(getHiddenText(e)!=null && !getHiddenText(e).isEmpty()) {
                int pos = getHiddenTextCounter(e);
                if(pos < getHiddenText(e).size()) {
                  String ws = getHiddenText(e).get(pos);
                  emit(w, ws);
                  incHiddenTextCounter(e);
                } else {
                  // Fallback for edited models: if a list mutation exhausts the
                  // original hidden-text entries, keep a neutral separator before
                  // closing delimiters. Exact parsed models should not reach this
                  // branch.
                  lastSeparatorProgrammatic = true;
                  emit(w, programmaticPolicy.separatorBeforeClosingDelimiter(e, ruleInfo));
                  // Do not throw here; keep rendering to preserve best-effort output
                }
            } else if(getHiddenText(e)==null) {
                lastSeparatorProgrammatic = true;
                emit(w, programmaticPolicy.separatorBefore(e, ruleInfo, context));
            } else {
                lastSeparatorProgrammatic = true;
                emit(w, programmaticPolicy.separatorBeforeEdited(e, ruleInfo, context));
            }
    }

    public void render(${model.grammarName}ModelUnparser unparser, RuleInfo ruleInfo, PrintWriter w, String s) {
      if(!consumeElement) {
        // the first rendered terminal fixes the start of every pending range
        for(java.util.Map.Entry<CodeElement, int[]> entry : pendingRanges.entrySet()) {
          if(entry.getValue() == null) {
            entry.setValue(new int[]{position, line});
          }
        }
        emit(w, s);
      }
    }

    @Override
    public void post(${model.grammarName}ModelUnparser unparser, RuleInfo ruleInfo, PrintWriter w) {
        if(!(ruleInfo.getRuleType()==RuleType.TERMINAL || ruleInfo.getRuleType()==RuleType.LEXER_RULE)) {
            return;
        }
        if(consumeElement) {
            return; // absent optional: nothing was rendered
        }
        lastTerminalText = ruleInfo.getRuleText();
        programmaticPolicy.terminal(ruleInfo, lastSeparatorProgrammatic);
    }
  } // end default-formatter

final class ConservativeSeparatorPolicy implements Formatter.ProgrammaticSeparatorPolicy {

  static final Formatter.ProgrammaticSeparatorPolicy INSTANCE = new ConservativeSeparatorPolicy();

  private ConservativeSeparatorPolicy() {
  }

  @Override
  public String separatorBefore(CodeElement parent, Formatter.RuleInfo ruleInfo) {
    return " ";
  }

  @Override
  public String separatorBeforeEdited(CodeElement parent, Formatter.RuleInfo ruleInfo) {
    // lexer-rule tokens (identifiers, numbers, ...) and word-like keywords such
    // as 'int' get a space so they never glue to the preceding token
    // ("int b" + "int insP" must not become "int bint insP"); punctuation
    // like ',' or ')' does not.
    if(ruleInfo.getRuleType() == Formatter.RuleType.LEXER_RULE) {
      return " ";
    }
    String text = ruleInfo.getRuleText();
    return text != null && !text.isEmpty() && Character.isJavaIdentifierPart(text.charAt(0)) ? " " : "";
  }

  @Override
  public String separatorBeforeClosingDelimiter(CodeElement parent, Formatter.RuleInfo ruleInfo) {
    String t = ruleInfo.getRuleText();
    if(")".equals(t) || "]".equals(t) || "}".equals(t)) {
      return " ";
    }
    return "";
  }
}


/**
 * A {@link Formatter.ProgrammaticSeparatorPolicy} for C-like syntax: breaks
 * the line after block openers, block closers and statement ends, indents by
 * block depth, and never glues tokens. It is only ever consulted for
 * programmatic or edited elements; parsed text keeps its own whitespace, and
 * because it is told about every terminal it knows the block depth at the
 * point where a programmatic subtree is inserted into parsed text.
 */
class BlockIndentSeparatorPolicy implements Formatter.ProgrammaticSeparatorPolicy {
  private String indentUnit = "  ";
  private final java.util.Set<String> openers = new java.util.HashSet<>(java.util.Arrays.asList("{"));
  private final java.util.Set<String> closers = new java.util.HashSet<>(java.util.Arrays.asList("}"));
  private final java.util.Set<String> statementEnds = new java.util.HashSet<>(java.util.Arrays.asList(";"));
  private final java.util.Set<String> noSpaceBefore = new java.util.HashSet<>(java.util.Arrays.asList(";", ",", ")", "]", ".", "("));
  private final java.util.Set<String> noSpaceAfter = new java.util.HashSet<>(java.util.Arrays.asList("(", "[", "."));
  private int depth = 0;

  public BlockIndentSeparatorPolicy withIndent(String unit) { this.indentUnit = unit; return this; }
  public BlockIndentSeparatorPolicy withOpeners(String... t) { openers.clear(); openers.addAll(java.util.Arrays.asList(t)); return this; }
  public BlockIndentSeparatorPolicy withClosers(String... t) { closers.clear(); closers.addAll(java.util.Arrays.asList(t)); return this; }
  public BlockIndentSeparatorPolicy withStatementEnds(String... t) { statementEnds.clear(); statementEnds.addAll(java.util.Arrays.asList(t)); return this; }
  public BlockIndentSeparatorPolicy withNoSpaceBefore(String... t) { noSpaceBefore.clear(); noSpaceBefore.addAll(java.util.Arrays.asList(t)); return this; }
  public BlockIndentSeparatorPolicy withNoSpaceAfter(String... t) { noSpaceAfter.clear(); noSpaceAfter.addAll(java.util.Arrays.asList(t)); return this; }

  private String indent(int d) {
    StringBuilder sb = new StringBuilder();
    for(int i = 0; i < d; i++) sb.append(indentUnit);
    return sb.toString();
  }

  @Override
  public void terminal(Formatter.RuleInfo ruleInfo, boolean programmatic) {
    String t = ruleInfo.getRuleText();
    if(openers.contains(t)) depth++;
    if(closers.contains(t)) depth = Math.max(0, depth - 1);
  }

  @Override
  public String separatorBefore(CodeElement parent, Formatter.RuleInfo ruleInfo, Formatter.FormattingContext ctx) {
    String t = ruleInfo.getRuleText();
    String prev = ctx.previousTerminalText();
    if(prev == null) {
      return "";
    }
    if(closers.contains(t)) {
      return (ctx.atLineStart() ? "" : "\n") + indent(Math.max(0, depth - 1));
    }
    if(noSpaceBefore.contains(t) || noSpaceAfter.contains(prev)) {
      return "";
    }
    if(openers.contains(prev) || closers.contains(prev) || statementEnds.contains(prev)) {
      return (ctx.atLineStart() ? "" : "\n") + indent(depth);
    }
    return " ";
  }

  @Override
  public String separatorBeforeEdited(CodeElement parent, Formatter.RuleInfo ruleInfo, Formatter.FormattingContext ctx) {
    return separatorBefore(parent, ruleInfo, ctx);
  }

  @Override
  public String separatorBefore(CodeElement parent, Formatter.RuleInfo ruleInfo) {
    return " ";
  }

  @Override
  public String separatorBeforeEdited(CodeElement parent, Formatter.RuleInfo ruleInfo) {
    return ruleInfo.getRuleType() == Formatter.RuleType.LEXER_RULE ? " " : "";
  }

  @Override
  public String separatorBeforeClosingDelimiter(CodeElement parent, Formatter.RuleInfo ruleInfo) {
    return "";
  }
}
